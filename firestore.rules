rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's highlights, notes and settings: only they can read or change them.
    match /users/{uid}/items/{item} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Leaderboard: any signed-in reader can see it; each person can only write their own row,
    // with sane numbers, and reading time can't grow faster than real time passes.
    match /board/{uid} {
      function okRow() {
        let d = request.resource.data;
        return d.keys().hasOnly(['chapters','minutes','streak','sl','best','saved','notes','studies','quiz','memorized','books','nick','name','ts'])
          && d.ts == request.time
          && d.chapters is int && d.chapters >= 0 && d.chapters <= 1189
          && d.minutes is int && d.minutes >= 0
          && d.streak is int && d.streak >= 0 && d.streak <= 20000
          && d.best is int && d.best >= 0 && d.best <= 20000
          && d.saved is int && d.saved >= 0 && d.saved <= 12000
          && d.notes is int && d.notes >= 0 && d.notes <= 100000
          && d.studies is int && d.studies >= 0 && d.studies <= 100000
          && d.quiz is int && d.quiz >= 0 && d.quiz <= 4756
          && d.memorized is int && d.memorized >= 0 && d.memorized <= 31102
          && d.books is int && d.books >= 0 && d.books <= 66
          && d.sl is string && d.sl.size() <= 10
          && d.nick is string && d.nick.size() <= 24
          && d.name is string && d.name.size() <= 40;
      }
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && okRow()
        && request.resource.data.minutes <= 240;
      allow update: if request.auth != null && request.auth.uid == uid && okRow()
        && request.resource.data.minutes - resource.data.minutes
           <= (request.time.toMillis() - resource.data.ts.toMillis()) / 60000 + 2;
    }
  }
}
